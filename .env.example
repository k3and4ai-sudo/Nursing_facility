# ============================================================
# Nursing Facility - 環境変数設定ファイル
# このファイルをコピーして .env にリネームしてください
# cp .env.example .env
# ============================================================

# --- Ollama (LLM) 設定 ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_EMBED_MODEL=gemma4:26b

# --- 音声処理設定 ---
# Whisper モデルサイズ: tiny | base | small | medium | large
WHISPER_MODEL_NAME=tiny

# TTS エンジン: gtts (Google TTS) | local (ローカル/モック)
TTS_ENGINE=gtts

# --- サーバー設定 ---
HOST=0.0.0.0
PORT=8000
